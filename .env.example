# Copier ce fichier en .env et adapter les valeurs si besoin.
# Lu par start-nginx-local.sh au démarrage pour générer assets/scripts/env.js,
# qui définit window.SHARD_API_BASE_URL avant le chargement de shard-api.js.

# URL de base de Shard-API (avec /api), utilisée par shard-api.js pour
# récupérer les civilisations/villes/quartiers/cartographie.
SHARD_API_BASE_URL=http://localhost:8000/api

# URL de ShardUI-2 : liens des popups et origine autorisée à transmettre le
# jeton de connexion à l'éditeur (postMessage).
UI_BASE_URL=http://localhost:5173

# Origines supplémentaires autorisées pour l'échange de jeton, séparées par
# des virgules (optionnel).
UI_ALLOWED_ORIGINS=

# En mode développement (npm run dev), .env.development surcharge ce fichier.

# ----- Génération hebdomadaire des cartes (scripts/map-generator) -----
# Clé API Minestrator (MineBoard > Compte > API) et identifiant du serveur.
# Utilisés pour récupérer les accès SFTP et envoyer save-off / save-on.
MINESTRATOR_API_KEY=
MINESTRATOR_SERVER_ID=

# Mot de passe SFTP (non renvoyé par l'API, obligatoire).
MINESTRATOR_SFTP_PASSWORD=

# Optionnel : accès SFTP explicites si l'API n'est pas utilisée.
MINESTRATOR_SFTP_HOST=
MINESTRATOR_SFTP_PORT=
MINESTRATOR_SFTP_USER=
# Dossier racine du serveur sur le SFTP (défaut : .)
MINESTRATOR_SFTP_ROOT=

# Optionnel : sauvegarde déjà présente sur la machine, utilisée à la place du SFTP
# (dossier du monde, contenant level.dat, ou dossier du serveur contenant world/).
# Équivaut à l'option --local-world, pour la génération comme pour les statistiques.
MAP_LOCAL_WORLD=

# Optionnel : nom du dossier du monde (défaut : level-name de server.properties).
MAP_WORLD_NAME=
# Suspendre la sauvegarde automatique pendant la copie (défaut : true).
MAP_SAVE_COMMANDS=true
# Secondes d'attente après save-all flush (défaut : 20).
MAP_SAVE_WAIT=20
# Threads MinedMap (0 = un par cœur).
MAP_JOBS=0
# Préfixes des panneaux à afficher sur la carte, séparés par des virgules (vide = aucun).
MAP_SIGN_PREFIX=

# ----- Statistiques du monde (scripts/map-generator/world_stats.py) -----
# Relevé envoyé à Shard-API après la génération (SHARD_API_BASE_URL ci-dessus).
# Clé partagée, identique à platforms.monde.key dans la configuration de Shard-API.
MAP_STATS_API_KEY=
# Relever les statistiques à chaque génération (défaut : true ; --no-stats pour une exécution).
MAP_STATS=true
# Heures de présence minimales dans un chunk pour que ses lits comptent dans la population (défaut : 10).
MAP_STATS_BED_HOURS=10
# Joueur actif : temps de jeu minimal en heures et connexion récente en jours (défauts : 1 et 30).
MAP_STATS_ACTIVE_HOURS=1
MAP_STATS_ACTIVE_DAYS=30
# Côté des zones les plus visitées, en blocs, et nombre de zones conservées (défauts : 256 et 25).
MAP_STATS_TILE=256
MAP_STATS_TOP_ZONES=25
# Rayon mesuré autour d'une ville ou d'un quartier sans frontières tracées (défauts : 128 et 64 blocs).
MAP_STATS_RADIUS=128
MAP_STATS_QUARTIER_RADIUS=64

# Optionnel : chemins des binaires MinedMap (défaut : ceux installés par run.sh
# dans scripts/map-generator/.cache/MinedMap-Viewer-Generator/MinedMap).
MINEDMAP_BIN=
# Ancien MinedMap 1.19, seul à rendre la surface du Nether (sous le toit de bedrock).
MINEDMAP_NETHER_BIN=
