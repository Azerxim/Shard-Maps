# Surcharge de .env en mode développement (npm run dev, MAPS_ENV=development).
# Valeurs locales uniquement : Shard-API en dev (config.json > api.development)
# et ShardUI-2 sur le serveur Vite. L'éditeur n'accepte le jeton que des
# origines UI_BASE_URL et UI_ALLOWED_ORIGINS, et l'utilise sur cette API :
# le jeton doit donc avoir été émis par la même API que SHARD_API_BASE_URL.

SHARD_API_BASE_URL=http://localhost:8002/api
UI_BASE_URL=http://localhost:5173
# Origines supplémentaires si ShardUI-2 est ouvert autrement (ex. http://127.0.0.1:5173).
# Chaque origine non correspondante produit un avertissement postMessage en console.
UI_ALLOWED_ORIGINS=
