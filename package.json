{
  "name": "shardui-2-maps",
  "version": "2.0.1",
  "private": true,
  "description": "NPM scripts for ShardUI-2-Maps",
  "scripts": {
    "init": "chmod +x start-nginx-local.sh install-nginx.sh",
    "dev": "./start-nginx-local.sh",
    "start": "./start-nginx-local.sh",
    "install:nginx": "sudo bash install-nginx.sh",
    "pm2:start": "pm2 start npm --name shardui-2-maps -- run start",
    "pm2:stop": "pm2 stop shardui-2-maps",
    "pm2:restart": "pm2 restart shardui-2-maps",
    "pm2:logs": "pm2 logs shardui-2-maps",
    "pm2:delete": "pm2 delete shardui-2-maps",
    "test": "echo \"Error: no test specified\" && exit 1"
  }
}
